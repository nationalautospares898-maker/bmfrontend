# --- Secrets and environment -------------------------------------------------
# Anything VITE_* is compiled into a publicly readable bundle. Never put a
# secret here. Only .env.example, with placeholders, is committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/

# --- Owner business records --------------------------------------------------
# The owner's original bill workbook is their business record, not a project
# artifact. Its contents are specified in
# ../bmbackend/docs/PHASE-2-CLOSURE-ADDENDUM-2.md.
ANAS_*.xlsx

# --- Node --------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
*.tsbuildinfo

