# Copy to .env.local for local development. `.env*` is git-ignored except this file.
#
# ⚠️ ANYTHING VITE_-PREFIXED IS COMPILED INTO A PUBLICLY READABLE BUNDLE.
# There is no such thing as a secret in this repository (NFR-SEC-012): no database URL,
# no JWT key, no storage credential. Only these four variables are permitted, and a
# structural test asserts no others are referenced.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_VERSION=dev

# Optional
# VITE_SENTRY_DSN=
# VITE_ENABLE_DEVTOOLS=true
